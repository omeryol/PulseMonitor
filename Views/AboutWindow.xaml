<Window x:Class="PulseMonitor.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PulseMonitor.Views"
        Title="{DynamicResource About.Title}"
        Width="560" Height="640" MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Ui.Window}"
        FontFamily="{DynamicResource Font.Ui}" FontSize="13" UseLayoutRounding="True">

    <!-- DataContext: AboutViewModel -->
    <DockPanel Margin="10">
        <Button DockPanel.Dock="Bottom" Content="{DynamicResource Settings.Close}" HorizontalAlignment="Right" MinWidth="90"
                Padding="12,4" Margin="0,10,0,0" IsCancel="True" Tag="Primary" Click="Close_Click" />
        <Border Background="{DynamicResource Ui.Card}" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1" CornerRadius="10"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,12,20,18">
            <views:AboutPanel />
        </ScrollViewer></Border>
    </DockPanel>
</Window>
