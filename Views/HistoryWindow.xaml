<Window x:Class="PulseMonitor.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource History.Title}"
        Width="820" Height="520" MinWidth="600" MinHeight="460"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.History.Window}"
        FontFamily="{DynamicResource Font.Ui}" FontSize="13" UseLayoutRounding="True">

    <!-- DataContext: HistoryViewModel. Üstte özet kartları, altta çubuk grafik (değer çizgileri, kesikli ortalama,
         hafta sonu gölgesi, üzerine gelince öne çıkan çubuk). Renkler: Resources/Theme.xaml → Brush.History.* -->
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.History.Card}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.History.Muted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Figure" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,16,20,16">
        <!-- Başlık ve gezinme -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="{DynamicResource History.Month}" IsChecked="True" Margin="0,0,14,0" GroupName="View" />
                <RadioButton Content="{DynamicResource History.Year}" IsChecked="{Binding YearView}" GroupName="View" />
            </StackPanel>
            <Button Content="◀" Command="{Binding PreviousCommand}" Width="32" Height="28" Margin="0,0,6,0" />
            <Button Content="▶" Command="{Binding NextCommand}" Width="32" Height="28" Margin="0,0,6,0" />
            <Button Content="{DynamicResource History.Today}" Command="{Binding TodayCommand}" Padding="10,2" Margin="0,0,16,0" />
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Özet kartları -->
        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,-10,18">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource History.Down}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding DownTotal}" Style="{StaticResource Figure}" Foreground="{DynamicResource Brush.History.DownText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource History.Up}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding UpTotal}" Style="{StaticResource Figure}" Foreground="{DynamicResource Brush.History.UpText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding AverageCaption}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Average}" Style="{StaticResource Figure}" Foreground="{DynamicResource Brush.History.Average}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource History.PeakCaption}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Peak}" Style="{StaticResource Figure}" />
                    <TextBlock Text="{Binding PeakName}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Lejant -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="64,12,0,0">
            <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Brush.History.DownFill}" Margin="0,0,6,0" />
            <TextBlock Text="{DynamicResource History.Down}" Margin="0,0,18,0" />
            <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Brush.History.UpFill}" Margin="0,0,6,0" />
            <TextBlock Text="{DynamicResource History.Up}" Margin="0,0,18,0" />
            <Line X1="0" X2="16" Y1="6" Y2="6" Stroke="{DynamicResource Brush.History.Average}" StrokeThickness="1.5"
                  StrokeDashArray="3 2" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="{DynamicResource History.AverageLegend}" />
        </StackPanel>

        <!-- Grafik: solda değer etiketleri, sağda çizim alanı -->
        <Grid VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Değer etiketleri -->
            <ItemsControl ItemsSource="{Binding GridLines}" Height="{Binding Height}" VerticalAlignment="Top" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom" Margin="0,0,10,-7">
                            <TextBlock.RenderTransform>
                                <TranslateTransform Y="{Binding Offset, Converter={StaticResource Negate}}" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Column="1">
                <!-- Değer çizgileri ve taban çizgisi -->
                <Grid Height="{Binding Height}" VerticalAlignment="Top">
                    <Rectangle Height="1" Fill="{DynamicResource Brush.History.Axis}" VerticalAlignment="Bottom" />
                    <ItemsControl ItemsSource="{Binding GridLines}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Height="1" Fill="{DynamicResource Brush.History.Grid}" VerticalAlignment="Bottom">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform Y="{Binding Offset, Converter={StaticResource Negate}}" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Çubuklar -->
                <ItemsControl ItemsSource="{Binding Bars}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="Column" Background="Transparent" ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="100">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{Binding DataContext.Height, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ToGridLength}}" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border x:Name="Shade" CornerRadius="4" Margin="1,0" />
                                <StackPanel x:Name="Bar" VerticalAlignment="Bottom" Margin="3,0" Opacity="0.88">
                                    <Border Height="{Binding UpHeight}" CornerRadius="4,4,0,0" Background="{DynamicResource Brush.History.UpFill}" />
                                    <Border Height="{Binding DownHeight}" CornerRadius="{Binding DownCorners}" Background="{DynamicResource Brush.History.DownFill}" />
                                </StackPanel>
                                <TextBlock x:Name="Label" Grid.Row="1" Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center"
                                           Margin="0,6,0,0" Foreground="{DynamicResource Brush.History.Muted}" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                    <Setter TargetName="Shade" Property="Background" Value="{DynamicResource Brush.History.Weekend}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Label" Property="FontWeight" Value="Bold" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.History.Average}" />
                                </DataTrigger>
                                <Trigger SourceName="Column" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                    <Setter TargetName="Shade" Property="Background" Value="{DynamicResource Brush.History.Hover}" />
                                    <Setter TargetName="Label" Property="FontWeight" Value="Bold" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Ortalama çizgisi -->
                <Grid Height="{Binding Height}" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Grid VerticalAlignment="Bottom">
                        <Grid.RenderTransform>
                            <TranslateTransform Y="{Binding AverageOffset, Converter={StaticResource Negate}}" />
                        </Grid.RenderTransform>
                        <Line X1="0" X2="1" Stretch="Fill" Stroke="{DynamicResource Brush.History.Average}" StrokeThickness="1.5"
                              StrokeDashArray="4 3" VerticalAlignment="Bottom" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,3" Padding="6,1" CornerRadius="4"
                                Background="{DynamicResource Brush.History.Average}">
                            <TextBlock Text="{Binding AverageLabel}" Foreground="White" FontSize="11" />
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
