<Window x:Class="PulseMonitor.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PulseMonitor.Views.Controls"
        Title="{DynamicResource History.Title}"
        Width="860" Height="600" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.History.Window}"
        FontFamily="{DynamicResource Font.Ui}" FontSize="13" UseLayoutRounding="True">

    <!-- DataContext: HistoryViewModel. Tüm görünüm türleri aynı tarihsel indirme/yükleme satırlarını çizer. -->
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource Ui.HistoryCard}" />
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Ui.HistoryCaption}" />
        <Style x:Key="Figure" TargetType="TextBlock" BasedOn="{StaticResource Ui.HistoryFigure}" />
    </Window.Resources>

    <DockPanel Margin="20,16,20,16">
        <!-- Başlık ve gezinme -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="MonthOption" Content="{DynamicResource History.Month}" IsChecked="True" Click="Month_Click" Margin="0,0,14,0" GroupName="View" />
                <RadioButton x:Name="YearOption" Content="{DynamicResource History.Year}" Click="Year_Click" GroupName="View" />
            </StackPanel>
            <Button Content="◀" Command="{Binding PreviousCommand}" Click="PeriodNavigation_Click" Width="32" Height="28" Margin="0,0,6,0" />
            <Button Content="▶" Command="{Binding NextCommand}" Click="PeriodNavigation_Click" Width="32" Height="28" Margin="0,0,6,0" />
            <Button Content="{DynamicResource History.Today}" Command="{Binding TodayCommand}" Click="PeriodNavigation_Click" Padding="10,2" Margin="0,0,16,0" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource Ui.WindowTitle}" FontSize="22" VerticalAlignment="Center" />
        </DockPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource History.Range}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <DatePicker SelectedDate="{Binding RangeStart}" Width="125" Margin="0,0,6,0" />
            <DatePicker SelectedDate="{Binding RangeEnd}" Width="125" Margin="0,0,6,0" />
            <Button Content="{DynamicResource History.ApplyRange}" Click="ApplyRange_Click" Margin="0,0,6,0" />
            <Button Content="{DynamicResource History.ExportCsv}" Click="ExportCsv_Click" Margin="0,0,18,0" />
        </WrapPanel>

        <!-- Özet kartları -->
        <UniformGrid DockPanel.Dock="Top" Columns="5" Margin="0,0,-10,18">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource History.Down}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding DownTotal}" Style="{StaticResource Figure}" Foreground="{DynamicResource Brush.History.DownText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource History.Up}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding UpTotal}" Style="{StaticResource Figure}" Foreground="{DynamicResource Brush.History.UpText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding AverageCaption}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Average}" Style="{StaticResource Figure}" Foreground="{DynamicResource Brush.History.Average}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource History.PeakCaption}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Peak}" Style="{StaticResource Figure}" />
                    <TextBlock Text="{Binding PeakName}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource History.Comparison}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Comparison}" Style="{StaticResource Figure}" Foreground="{DynamicResource Brush.History.Average}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ScottPlot'in etkileşimli, MIT lisanslı grafik yüzeyi. -->
        <Border Background="{DynamicResource Brush.History.Card}" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1" CornerRadius="12" Padding="12,10,12,6">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource History.ChartType}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding ChartTypes}" SelectedItem="{Binding SelectedChart}" DisplayMemberPath="Display" Width="150" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource Brush.History.DownFill}" Margin="0,0,5,0" />
                        <TextBlock Text="{DynamicResource History.Down}" Style="{StaticResource Caption}" Margin="0,0,12,0" />
                        <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource Brush.History.UpFill}" Margin="0,0,5,0" />
                        <TextBlock Text="{DynamicResource History.Up}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Grid>
                <controls:TrafficPlot Grid.Row="1" Items="{Binding Bars}" ChartType="{Binding ChartType}" Version="{Binding TrafficVersion}" MinHeight="270" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
