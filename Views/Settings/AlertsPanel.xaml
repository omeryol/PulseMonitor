<UserControl x:Class="PulseMonitor.Views.Settings.AlertsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext: AlertsSettingsViewModel. Her satır: aç/kapa + eşik kaydırıcısı + değer. -->
    <UserControl.Resources>
        <Style TargetType="DockPanel">
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Value">
            <Setter Property="Width" Value="64" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{DynamicResource Alerts.Hint}" TextWrapping="Wrap" Foreground="{DynamicResource Ui.Muted}" Margin="0,0,0,8" />

        <DockPanel>
            <CheckBox Width="250" VerticalAlignment="Center" Content="{DynamicResource Alerts.Traffic}" IsChecked="{Binding TrafficEnabled}" />
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding TrafficLimitGb, StringFormat={}{0} GB}" />
            <Slider Minimum="1" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TrafficLimitGb}" AutomationProperties.Name="{DynamicResource Alerts.Traffic}" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel>
            <CheckBox Width="250" VerticalAlignment="Center" Content="{DynamicResource Alerts.Cpu}" IsChecked="{Binding CpuEnabled}" />
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding CpuPercent, StringFormat=% {0}}" />
            <Slider Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding CpuPercent}" AutomationProperties.Name="{DynamicResource Alerts.Cpu}" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel>
            <CheckBox Width="250" VerticalAlignment="Center" Content="{DynamicResource Alerts.Ram}" IsChecked="{Binding RamEnabled}" />
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding RamPercent, StringFormat=% {0}}" />
            <Slider Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding RamPercent}" AutomationProperties.Name="{DynamicResource Alerts.Ram}" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel>
            <CheckBox Width="250" VerticalAlignment="Center" Content="{DynamicResource Alerts.GpuTemp}" IsChecked="{Binding GpuTempEnabled}" />
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding GpuTempC, StringFormat={}{0} °C}" />
            <Slider Minimum="30" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GpuTempC}" AutomationProperties.Name="{DynamicResource Alerts.GpuTemp}" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel>
            <CheckBox Width="250" VerticalAlignment="Center" Content="{DynamicResource Alerts.DiskTemp}" IsChecked="{Binding DiskTempEnabled}" />
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding DiskTempC, StringFormat={}{0} °C}" />
            <Slider Minimum="30" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DiskTempC}" AutomationProperties.Name="{DynamicResource Alerts.DiskTemp}" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Hava durumu uyarıları: seviye + sessiz saatler. Resmî uyarı olmadığı notu her zaman görünür. -->
        <TextBlock Text="{DynamicResource Alerts.Weather}" FontWeight="SemiBold" Margin="0,16,0,0" />
        <DockPanel>
            <TextBlock Text="{DynamicResource Alerts.WeatherLevel}" Width="190" VerticalAlignment="Center" />
            <ComboBox AutomationProperties.Name="{DynamicResource Alerts.WeatherLevel}" ItemsSource="{Binding WeatherLevel.Options}" SelectedItem="{Binding WeatherLevel.Selected}" DisplayMemberPath="Display" />
        </DockPanel>
        <CheckBox Content="{DynamicResource Alerts.WeatherQuiet}" IsChecked="{Binding WeatherQuietHours}" Margin="0,3" />
        <TextBlock Text="{DynamicResource Alerts.WeatherNote}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Ui.Muted}" Margin="0,4,0,0" />

        <Button Content="{DynamicResource Alerts.Test}" Command="{Binding TestCommand}" HorizontalAlignment="Left"
                Padding="12,4" Margin="0,14,0,0" />
    </StackPanel>
</UserControl>
