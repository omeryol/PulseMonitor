<UserControl x:Class="PulseMonitor.Views.Settings.ItemsSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext: ItemsSettingsViewModel -->
    <StackPanel>
        <TextBlock Text="{DynamicResource Items.Hint}" TextWrapping="Wrap" Foreground="{DynamicResource Ui.Muted}" Margin="0,0,0,6" />
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Top">
                <Button Content="{DynamicResource Items.MoveUp}" Command="{Binding MoveUpCommand}"
                        MinWidth="90" Padding="8,3" Margin="0,0,0,6" />
                <Button Content="{DynamicResource Items.MoveDown}" Command="{Binding MoveDownCommand}"
                        MinWidth="90" Padding="8,3" />
            </StackPanel>
            <ListBox AutomationProperties.Name="{DynamicResource Settings.Tab.Items}" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding Visible}" Margin="0,2" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </StackPanel>
</UserControl>
