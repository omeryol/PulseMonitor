<UserControl x:Class="PulseMonitor.Views.Settings.TrafficQuotaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="DockPanel"><Setter Property="Margin" Value="0,6" /></Style>
        <Style TargetType="TextBlock" x:Key="Value"><Setter Property="Width" Value="64" /><Setter Property="TextAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource Ui.Card}" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1" CornerRadius="8" Padding="12">
    <StackPanel>
        <CheckBox Content="{DynamicResource Alerts.Traffic}" IsChecked="{Binding TrafficEnabled}" Margin="0,0,0,4" />
        <DockPanel>
            <TextBlock Text="{DynamicResource Alerts.TrafficLimit}" Style="{StaticResource Ui.FormLabel}" Width="190" />
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding TrafficLimitGb, StringFormat={}{0} GB}" />
            <Slider Minimum="1" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TrafficLimitGb}" />
        </DockPanel>
        <DockPanel>
            <TextBlock Text="{DynamicResource Alerts.TrafficCycleDay}" Style="{StaticResource Ui.FormLabel}" Width="190" />
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding TrafficCycleStartDay}" />
            <Slider Minimum="1" Maximum="28" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TrafficCycleStartDay}" />
        </DockPanel>
        <DockPanel>
            <TextBlock Text="{DynamicResource Alerts.TrafficThreshold}" Style="{StaticResource Ui.FormLabel}" Width="190" />
            <ComboBox ItemsSource="{Binding TrafficWarningPercent.Options}" SelectedItem="{Binding TrafficWarningPercent.Selected}" DisplayMemberPath="Display" />
        </DockPanel>
    </StackPanel>
    </Border>
</UserControl>
