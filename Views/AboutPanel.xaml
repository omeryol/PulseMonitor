<UserControl x:Class="PulseMonitor.Views.AboutPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Hyperlink.RequestNavigate="OnRequestNavigate">

    <!-- DataContext: AboutViewModel. Ayarlar → Hakkında sekmesinde ve Hakkında penceresinde kullanılır.
         Kaynak gösterimi lisans gereğidir (Open-Meteo CC BY 4.0, OSM ODbL, GeoNames CC BY 4.0, simgeler MIT). -->
    <UserControl.Resources>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Ui.SectionHeading}" />
        <Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource Ui.Caption}" />
        <Style x:Key="DocCard" TargetType="Border" BasedOn="{StaticResource Ui.DocumentCard}" />
        <Style x:Key="AboutCard" TargetType="Border" BasedOn="{StaticResource Ui.InsetCard}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="76" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,2,0,0">
        <!-- Kimlik kartı: ürün adı, sürümü ve vaadi ilk bakışta görünür. -->
        <Border Style="{StaticResource Ui.SurfaceCard}" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/AppIcon.png" Width="48" Height="48" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Ui.WindowTitle}" Text="PulseMonitor" />
                        <Border Style="{StaticResource Ui.StatusPill}" Margin="10,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Version, Mode=OneWay}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource About.Tagline}" Style="{StaticResource Small}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Proje ve lisans bilgileri kısa kartlar hâlinde. -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource AboutCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource About.Project}" Style="{StaticResource Small}" />
                    <TextBlock Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                        <Hyperlink NavigateUri="https://github.com/omeryol/PulseMonitor">github.com/omeryol/PulseMonitor</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource AboutCard}" Margin="0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource About.License}" Style="{StaticResource Small}" />
                    <TextBlock Margin="0,4,0,0">
                        <Hyperlink NavigateUri="https://opensource.org/license/mit">MIT</Hyperlink>
                        <Run Text=" · © 2026 omeryol" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Style="{StaticResource Small}" Margin="0,2,0,6">
            <Run Text="{DynamicResource About.Inspired}" />
            <Hyperlink NavigateUri="https://github.com/zhongyang219/TrafficMonitor">TrafficMonitor</Hyperlink>
            <Run Text="{DynamicResource About.InspiredRest}" />
        </TextBlock>

        <!-- Güncelleme eylemi kendi yüzeyinde: durum ve sonraki eylem aynı yerde. -->
        <Border Style="{StaticResource Ui.InsetCard}" Margin="0,6,0,2">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{DynamicResource Update.Download}" Command="{Binding DownloadCommand}"
                            Style="{StaticResource Ui.PrimaryButton}" Margin="8,0,0,0"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{DynamicResource Update.CheckNow}" Command="{Binding CheckCommand}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding UpdateText}" Style="{StaticResource Ui.Body}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TextBlock Text="{DynamicResource About.DataHeading}" Style="{StaticResource Heading}" />
        <Border Style="{StaticResource Ui.InsetCard}">
            <StackPanel>
                <TextBlock Margin="0,1"><Hyperlink NavigateUri="https://open-meteo.com">Open-Meteo</Hyperlink><Run Text="{DynamicResource About.Data.OpenMeteo}" /><Hyperlink NavigateUri="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</Hyperlink></TextBlock>
                <TextBlock Margin="0,5,0,0"><Hyperlink NavigateUri="https://www.openstreetmap.org/copyright">© OpenStreetMap</Hyperlink><Run Text="{DynamicResource About.Data.Osm}" /><Hyperlink NavigateUri="https://opendatacommons.org/licenses/odbl/">ODbL</Hyperlink></TextBlock>
                <TextBlock Margin="0,5,0,0"><Hyperlink NavigateUri="https://www.geonames.org">GeoNames</Hyperlink><Run Text="{DynamicResource About.Data.GeoNames}" /><Hyperlink NavigateUri="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</Hyperlink></TextBlock>
                <TextBlock Margin="0,5,0,0"><Hyperlink NavigateUri="https://www.ipify.org">ipify</Hyperlink><Run Text="{DynamicResource About.Data.Ipify}" /></TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Text="{DynamicResource About.IconsHeading}" Style="{StaticResource Heading}" />
        <Border Style="{StaticResource Ui.InsetCard}">
            <WrapPanel>
                <TextBlock Margin="0,0,14,5"><Hyperlink NavigateUri="https://github.com/basmilius/meteocons">Meteocons</Hyperlink><Run Text=" · MIT" /></TextBlock>
                <TextBlock Margin="0,0,14,5"><Hyperlink NavigateUri="https://github.com/Makin-Things/weather-icons">Makin-Things</Hyperlink><Run Text=" · MIT" /></TextBlock>
                <TextBlock Margin="0,0,14,5"><Hyperlink NavigateUri="https://github.com/microsoft/fluentui-emoji">Fluent Emoji</Hyperlink><Run Text=" · MIT" /></TextBlock>
                <TextBlock Margin="0,0,14,5"><Hyperlink NavigateUri="https://github.com/microsoft/fluentui-system-icons">Fluent UI Icons</Hyperlink><Run Text=" · MIT" /></TextBlock>
            </WrapPanel>
        </Border>

        <TextBlock Text="{DynamicResource About.PrivacyHeading}" Style="{StaticResource Heading}" />
        <Border Style="{StaticResource Ui.Notice}">
            <TextBlock Text="{DynamicResource About.Privacy}" Style="{StaticResource Ui.Body}" />
        </Border>

        <Expander Header="{DynamicResource About.FullTexts}" Margin="0,16,0,0">
            <StackPanel Margin="0,8,0,0">
                <Border Style="{StaticResource DocCard}" Margin="0,0,0,10">
                    <FlowDocumentScrollViewer Document="{Binding LicenseText, Converter={StaticResource MarkdownDocument}}"
                                              MaxHeight="260" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" />
                </Border>
                <Border Style="{StaticResource DocCard}">
                    <FlowDocumentScrollViewer Document="{Binding NoticesText, Converter={StaticResource MarkdownDocument}}"
                                              MaxHeight="420" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" />
                </Border>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
