<UserControl x:Class="PulseMonitor.Views.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- Renk seçici: kutuya tıklayınca hazır renkler + ton / doygunluk / parlaklık kaydırıcıları açılır.
         SelectedColor (#RRGGBB) iki yönlü bağlanır. Kod: ColorPicker.xaml.cs -->
    <Grid>
        <ToggleButton x:Name="Toggle" AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Root}" Width="34" Height="22" Cursor="Hand" ToolTip="{DynamicResource ColorPicker.Hint}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Box" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Ui.Border}"
                            Background="{Binding PreviewBrush, ElementName=Root}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
                            <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup IsOpen="{Binding IsChecked, ElementName=Toggle}" PlacementTarget="{Binding ElementName=Toggle}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Closed="OnPopupClosed">
            <Border Background="{DynamicResource Ui.Card}" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1"
                    CornerRadius="10" Padding="12" Margin="6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18" />
                </Border.Effect>
                <StackPanel Width="292">
                    <TextBlock Text="{DynamicResource ColorPicker.Presets}" Foreground="{DynamicResource Ui.Muted}" FontSize="11" Margin="0,0,0,6" />
                    <ItemsControl x:Name="Swatches">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="10" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OnSwatchClick" Tag="{Binding}" Width="25" Height="25" Margin="2" Cursor="Hand" ToolTip="{Binding}" AutomationProperties.Name="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Sw" CornerRadius="5" Background="{Binding}" BorderThickness="1" BorderBrush="#22000000" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Sw" Property="BorderBrush" Value="{DynamicResource Ui.Text}" />
                                                    <Setter TargetName="Sw" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{DynamicResource ColorPicker.Custom}" Foreground="{DynamicResource Ui.Muted}" FontSize="11" Margin="0,12,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource ColorPicker.Hue}" VerticalAlignment="Center" />
                        <Grid Grid.Column="1" Margin="0,3">
                            <Border Height="8" CornerRadius="4" VerticalAlignment="Center" Margin="5,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF0000" Offset="0" /><GradientStop Color="#FFFF00" Offset="0.17" />
                                        <GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.5" />
                                        <GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" />
                                        <GradientStop Color="#FF0000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Slider x:Name="Hue" Minimum="0" Maximum="360" ValueChanged="OnSliderChanged" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{DynamicResource ColorPicker.Saturation}" VerticalAlignment="Center" />
                        <Slider x:Name="Saturation" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Margin="0,3" ValueChanged="OnSliderChanged" />
                        <TextBlock Grid.Row="2" Text="{DynamicResource ColorPicker.Brightness}" VerticalAlignment="Center" />
                        <Slider x:Name="Brightness" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" Margin="0,3" ValueChanged="OnSliderChanged" />
                    </Grid>

                    <DockPanel Margin="0,10,0,0">
                        <Border DockPanel.Dock="Left" Width="44" Height="26" CornerRadius="6" Background="{Binding PreviewBrush, ElementName=Root}"
                                BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1" Margin="0,0,10,0" />
                        <TextBox x:Name="HexBox" DockPanel.Dock="Right" Width="80" FontFamily="Consolas" MaxLength="7" Padding="3,2"
                                 VerticalContentAlignment="Center" LostFocus="OnHexCommitted" KeyDown="OnHexKeyDown"
                                 ToolTip="{DynamicResource ColorPicker.HexHint}" />
                        <TextBlock Text="{DynamicResource ColorPicker.Code}" Foreground="{DynamicResource Ui.Muted}" FontSize="11"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
