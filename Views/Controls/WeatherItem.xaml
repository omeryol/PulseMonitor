<UserControl x:Class="PulseMonitor.Views.Controls.WeatherItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PulseMonitor.Views.Controls"
             Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
             ToolTip="{Binding TooltipText}"
             ToolTipService.InitialShowDelay="400"
             ToolTipService.ShowDuration="60000">

    <!-- DataContext: WeatherViewModel. Simge 26×26 sabit: resim (Renkli/Gerçekçi) ya da temanın yazı renginde şekil
         (Çizgi/Dolu). Sıcaklık satırı görünmez yer tutucuyla sabit; hava değişince genişlik değişmez.
         Animasyon (yağmur, kar, sis, şimşek) içeriğin arkasında, yalnızca bu öğenin alanında. -->
    <Grid Opacity="{Binding Opacity}">
        <controls:WeatherAnimation Kind="{Binding Animation}" Margin="-6,-4" />

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Source="{Binding Icon}" Width="26" Height="26" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <Path Data="{Binding IconShape}" Fill="{DynamicResource Brush.Text}" Stretch="Uniform"
                  Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe UI Symbol" FontSize="20"
                       TextAlignment="Center" VerticalAlignment="Center" />
            <controls:SpriteIcon Strip="{Binding IconStrip}" Still="{Binding IconStill}" Animate="{Binding AnimateIcon}"
                                 Width="30" Height="30" Margin="-2" RenderOptions.BitmapScalingMode="HighQuality" />

            <Grid Grid.Column="1" Margin="6,0,0,0" Typography.NumeralAlignment="Tabular">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Visibility="Hidden">
                    <Run Text="{Binding TemperaturePlaceholder, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{Binding FeelsLikePlaceholder, Mode=OneWay}" FontSize="10" />
                </TextBlock>
                <TextBlock>
                    <Run Text="{Binding TemperatureText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{Binding TemperatureBrush}" />
                    <Run Text="{Binding FeelsLikeText, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
                </TextBlock>
                <TextBlock Grid.Row="1" Text="{Binding PlaceName}" Foreground="{DynamicResource Brush.Muted}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
