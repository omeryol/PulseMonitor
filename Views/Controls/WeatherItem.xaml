<UserControl x:Class="PulseMonitor.Views.Controls.WeatherItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PulseMonitor.Views.Controls"
             Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
             ToolTipService.IsEnabled="{DynamicResource DetailCards.Enabled}"
             ToolTipService.InitialShowDelay="400"
             ToolTipService.ShowDuration="60000"
             MouseLeftButtonDown="OnMouseLeftButtonDown">

    <!-- Renkli ipucu kartı: görev çubuğu temasına uyar (Brush.Tooltip.*). İçerik: WeatherTooltipModel. -->
    <UserControl.ToolTip>
        <ToolTip Content="{Binding Tooltip}" Style="{StaticResource Ui.TooltipCard}">
            <ToolTip.ContentTemplate>
                <DataTemplate>
                    <StackPanel TextElement.Foreground="{DynamicResource Brush.Text}" TextElement.FontFamily="{DynamicResource Font.Ui}"
                                TextElement.FontSize="12" MinWidth="220" Typography.NumeralAlignment="Tabular">
                        <TextBlock FontSize="13" FontWeight="SemiBold">
                            <Run Text="{Binding Place, Mode=OneWay}" />
                            <Run Text="{Binding Context, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource Brush.Muted}" />
                        </TextBlock>

                        <DockPanel Margin="0,8,0,0">
                            <Image Source="{Binding Icon}" Width="40" Height="40" Margin="0,0,10,0" DockPanel.Dock="Left" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock>
                                    <Run Text="{Binding Temperature, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="{Binding TemperatureBrush}" />
                                    <Run Text="{Binding Description, Mode=OneWay}" FontSize="13" />
                                </TextBlock>
                                <TextBlock Text="{Binding Details}" Foreground="{DynamicResource Brush.Muted}" FontSize="11" />
                            </StackPanel>
                        </DockPanel>

                        <Rectangle Height="1" Fill="{DynamicResource Brush.Tooltip.Border}" Margin="0,10,0,8" />
                        <!-- Saatlik tahmin yatay şerit: her saat bir sütun, sütunlar kart genişliğini eşit paylaşır. -->
                        <ItemsControl ItemsSource="{Binding Hours}" Visibility="{Binding HasHours, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Brush.Muted}" FontSize="11" HorizontalAlignment="Center" />
                                        <Image Source="{Binding Icon}" Width="26" Height="26" Margin="0,3" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Temperature}" FontWeight="SemiBold" Foreground="{Binding TemperatureBrush}" HorizontalAlignment="Center" />
                                        <!-- Yağış yoksa yer korunur (Hidden): satırlar hizalı kalsın. -->
                                        <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Tooltip.Rain}" HorizontalAlignment="Center" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasRain}" Value="False">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="☂ " /><Run Text="{Binding Rain, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Günlük tahmin: gün adı, simge, en yüksek / en düşük, yağış. Saatlik ile birlikteyse arada çizgi. -->
                        <Rectangle Height="1" Fill="{DynamicResource Brush.Tooltip.Border}" Margin="0,8,0,8"
                                   Visibility="{Binding HasBoth, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Days}" Visibility="{Binding HasDays, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Day}" Foreground="{DynamicResource Brush.Muted}" FontSize="11" HorizontalAlignment="Center" />
                                        <Image Source="{Binding Icon}" Width="26" Height="26" Margin="0,3" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding High}" FontWeight="SemiBold" Foreground="{Binding HighBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Low}" FontSize="11" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Center" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Tooltip.Rain}" HorizontalAlignment="Center" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasRain}" Value="False">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="☂ " /><Run Text="{Binding Rain, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Diğer takip edilen konumlar: ad solda, simge + sıcaklık sağda. -->
                        <StackPanel Visibility="{Binding HasOthers, Converter={StaticResource BoolToVisibility}}">
                            <Rectangle Height="1" Fill="{DynamicResource Brush.Tooltip.Border}" Margin="0,8,0,6" />
                            <ItemsControl ItemsSource="{Binding Others}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Temperature}" FontWeight="SemiBold" MinWidth="34"
                                                       TextAlignment="Right" Foreground="{Binding TemperatureBrush}" VerticalAlignment="Center" />
                                            <Image DockPanel.Dock="Right" Source="{Binding Icon}" Width="20" Height="20" Margin="8,0,4,0" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource Weather.ClickToSwitch}" FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0" />
                        </StackPanel>

                        <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource Brush.Muted}">
                            <Run Text="{Binding Updated, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{DynamicResource Weather.Stale}" FontSize="11" Foreground="{DynamicResource Brush.Load.Warn}" TextWrapping="Wrap"
                                   Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DataTemplate>
            </ToolTip.ContentTemplate>
        </ToolTip>
    </UserControl.ToolTip>

    <!-- DataContext: WeatherViewModel. Simge 26×26 sabit: resim (Renkli/Gerçekçi) ya da temanın yazı renginde şekil
         (Çizgi/Dolu). Sıcaklık satırı görünmez yer tutucuyla sabit; hava değişince genişlik değişmez.
         Animasyon (yağmur, kar, sis, şimşek) içeriğin arkasında, yalnızca bu öğenin alanında. -->
    <Grid Opacity="{Binding Opacity}">
        <controls:WeatherAnimation Kind="{Binding Animation}" Margin="-6,-4" />

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Source="{Binding Icon}" Width="26" Height="26" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <Path Data="{Binding IconShape}" Fill="{DynamicResource Brush.Text}" Stretch="Uniform"
                  Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe UI Symbol" FontSize="20"
                       TextAlignment="Center" VerticalAlignment="Center" />
            <controls:SpriteIcon Strip="{Binding IconStrip}" Still="{Binding IconStill}" Animate="{Binding AnimateIcon}"
                                 Width="30" Height="30" Margin="-2" RenderOptions.BitmapScalingMode="HighQuality" />

            <Grid Grid.Column="1" Margin="6,0,0,0" MaxWidth="170" Typography.NumeralAlignment="Tabular">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Visibility="Hidden">
                    <Run Text="{Binding TemperaturePlaceholder, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{Binding FeelsLikePlaceholder, Mode=OneWay}" FontSize="10" />
                </TextBlock>
                <TextBlock>
                    <Run Text="{Binding TemperatureText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{Binding TemperatureBrush}" />
                    <Run Text="{Binding FeelsLikeText, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
                </TextBlock>
                <!-- Yer adı satırı: görünmez en geniş metin genişliği sabitler, çok uzunsa üç nokta ile kesilir. -->
                <Grid Grid.Row="1">
                    <TextBlock Text="{Binding PlacePlaceholder}" Visibility="Hidden" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PlaceName}" Foreground="{DynamicResource Brush.Muted}" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
