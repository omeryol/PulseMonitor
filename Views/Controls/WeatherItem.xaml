<UserControl x:Class="PulseMonitor.Views.Controls.WeatherItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PulseMonitor.Views.Controls"
             Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
             MouseLeftButtonDown="OnMouseLeftButtonDown">

    <!-- DataContext: WeatherViewModel. Simge 26×26 sabit: resim (Renkli/Gerçekçi) ya da temanın yazı renginde şekil
         (Çizgi/Dolu). Sıcaklık satırı görünmez yer tutucuyla sabit; hava değişince genişlik değişmez.
         Animasyon sütunun tamamında, içeriğin önünde (Views/TaskbarWindow.xaml sütun şablonu). -->
    <Grid Opacity="{Binding Opacity}">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Source="{Binding Icon}" Width="32" Height="32" VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Style>
                    <Style TargetType="Image">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCinematicIcon}" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.15625" ScaleY="1.15625" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
            <Path Data="{Binding IconShape}" Fill="{DynamicResource Brush.Text}" Stretch="Uniform"
                  Width="27" Height="27" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe UI Symbol" FontSize="24"
                       TextAlignment="Center" VerticalAlignment="Center" />
            <controls:SpriteIcon Strip="{Binding IconStrip}" Still="{Binding IconStill}" Animate="{Binding AnimateIcon}"
                                 Width="37" Height="37" Margin="-2.5" RenderOptions.BitmapScalingMode="HighQuality" />

            <Grid Grid.Column="1" Margin="6,0,0,0" MaxWidth="170" Typography.NumeralAlignment="Tabular">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Visibility="Hidden">
                    <Run Text="{Binding TemperaturePlaceholder, Mode=OneWay}" FontWeight="SemiBold" FontSize="{DynamicResource Font.Size.WeatherTemp}" />
                    <Run Text="{Binding FeelsLikePlaceholder, Mode=OneWay}" FontSize="10" />
                </TextBlock>
                <TextBlock HorizontalAlignment="Center">
                    <Run Text="{Binding TemperatureText, Mode=OneWay}" FontWeight="SemiBold" FontSize="{DynamicResource Font.Size.WeatherTemp}" Foreground="{Binding TemperatureBrush}" />
                    <Run Text="{Binding FeelsLikeText, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
                </TextBlock>
                <!-- Yer adı satırı: görünmez ortalama uzunluktaki metin genişliği sabitler; daha uzun metin küçülerek sığar (ShrinkToFit). -->
                <Grid Grid.Row="1">
                    <TextBlock Text="{Binding PlacePlaceholder}" Visibility="Hidden" />
                    <controls:ShrinkToFit>
                        <TextBlock Text="{Binding PlaceName}" Foreground="{DynamicResource Brush.Muted}" TextTrimming="CharacterEllipsis" />
                    </controls:ShrinkToFit>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
