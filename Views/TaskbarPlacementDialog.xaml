<Window x:Class="PulseMonitor.Views.TaskbarPlacementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Taskbar.MoveLeftTitle}"
        Width="410" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" Background="{DynamicResource Ui.Window}"
        Foreground="{DynamicResource Ui.Text}" FontFamily="{DynamicResource Font.Ui}"
        FontSize="13" UseLayoutRounding="True">

    <Border Margin="16" Padding="18" Background="{DynamicResource Ui.Card}"
            BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource Ui.AccentSoft}" VerticalAlignment="Top">
                <TextBlock Text="&#xE8FD;" FontFamily="{DynamicResource Ui.Icons}" FontSize="15"
                           Foreground="{DynamicResource Ui.AccentOnSoft}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{DynamicResource Taskbar.MoveLeftTitle}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Taskbar.MoveLeftQuestion}" Foreground="{DynamicResource Ui.Muted}"
                           TextWrapping="Wrap" Margin="0,7,0,18" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Tag="Primary" IsDefault="True" Click="MoveLeft_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" FontFamily="{DynamicResource Ui.Icons}" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Taskbar.MoveLeftYes}" />
                        </StackPanel>
                    </Button>
                    <Button IsCancel="True" Click="KeepRight_Click" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72A;" FontFamily="{DynamicResource Ui.Icons}" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Taskbar.MoveLeftNo}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
