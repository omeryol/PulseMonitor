<Window x:Class="PulseMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:PulseMonitor.Views.Settings"
        xmlns:views="clr-namespace:PulseMonitor.Views"
        Title="{DynamicResource Settings.Title}"
        Width="780" Height="720" MinWidth="640" MinHeight="460" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Ui.Window}"
        Foreground="{StaticResource Ui.Text}" FontFamily="{DynamicResource Font.Ui}" FontSize="13"
        UseLayoutRounding="True">

    <!-- Solda simgeli dikey sekmeler, sağda beyaz içerik kartı (Resources/WindowStyles.xaml).
         Her değişiklik hemen uygulanır ve kaydedilir. Sekme simgeleri: Segoe Fluent Icons. -->
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Ui.Heading}" />
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="22,10,22,20" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Top" Margin="4,0,0,14">
            <Image Source="/Assets/AppIcon.png" Width="28" Height="28" Margin="0,0,10,0" />
            <TextBlock Text="{DynamicResource Settings.Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{DynamicResource Settings.AutoSave}" Foreground="{StaticResource Ui.Muted}" FontSize="12" VerticalAlignment="Center" />
            <Button Content="{DynamicResource Settings.Close}" HorizontalAlignment="Right" MinWidth="100" Tag="Primary"
                    IsCancel="True" Click="Close_Click" />
        </DockPanel>

        <TabControl Style="{StaticResource Ui.SideTabs}">
            <TabItem Header="{DynamicResource Settings.Tab.Items}" Tag="&#xE8FD;">
                <ScrollViewer>
                    <settings:ItemsSettingsPanel DataContext="{Binding Items}" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Settings.Tab.Style}" Tag="&#xE790;">
                <ScrollViewer>
                    <settings:StylePanel DataContext="{Binding Style}" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Settings.Tab.Weather}" Tag="&#xE753;">
                <ScrollViewer>
                    <StackPanel>
                        <settings:WeatherSettingsPanel DataContext="{Binding Weather}" />
                        <TextBlock Text="{DynamicResource Style.Section.Weather}" Style="{StaticResource Heading}" />
                        <settings:WeatherStylePanel DataContext="{Binding Style}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Settings.Tab.Alerts}" Tag="&#xEA8F;">
                <ScrollViewer>
                    <settings:AlertsPanel DataContext="{Binding Alerts}" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Settings.Tab.General}" Tag="&#xE713;">
                <ScrollViewer>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.Network}" Style="{StaticResource Heading}" Margin="0,2,0,6" />
                        <TextBlock Text="{DynamicResource Settings.Adapter}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="Display" />
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Settings.OpenHistory}" Command="{Binding OpenHistoryCommand}" Padding="10,2" />
                            <TextBlock Text="{DynamicResource Settings.Today}" Margin="0,0,8,0" Foreground="#555" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TodayText}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="{DynamicResource Settings.PingHost}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBox Text="{Binding PingHost, UpdateSourceTrigger=LostFocus}" Padding="4,2" />
                        </DockPanel>

                        <TextBlock Text="{DynamicResource Settings.General}" Style="{StaticResource Heading}" />
                        <CheckBox Content="{DynamicResource Settings.Startup}" IsChecked="{Binding StartWithWindows}" />
                        <CheckBox Content="{DynamicResource Settings.HideFullscreen}" IsChecked="{Binding HideInFullscreen}" />
                        <CheckBox Content="{DynamicResource Settings.CheckUpdates}" IsChecked="{Binding CheckForUpdates}" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right"
                                       Text="{Binding TrayGapPx, StringFormat={}{0} px}" />
                            <TextBlock Text="{DynamicResource Settings.Gap}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <Slider Minimum="0" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding TrayGapPx}" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource Settings.Tab.About}" Tag="&#xE946;">
                <ScrollViewer>
                    <views:AboutPanel DataContext="{Binding About}" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
