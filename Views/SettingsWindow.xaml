<Window x:Class="PulseMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:PulseMonitor.Views.Settings"
        Title="{DynamicResource Settings.Title}"
        Width="600" Height="700" MinWidth="520" MinHeight="420" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource Font.Ui}" FontSize="13"
        UseLayoutRounding="True">

    <!-- Sekmeler: Göstergeler · Görünüm · Hava durumu · Genel. Her değişiklik hemen uygulanır ve kaydedilir. -->
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="16,8,16,16" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <Button DockPanel.Dock="Bottom" Content="{DynamicResource Settings.Close}" HorizontalAlignment="Right" MinWidth="90"
                Padding="12,4" Margin="0,10,0,0" IsCancel="True" Click="Close_Click" />

        <TabControl>
            <TabItem Header="{DynamicResource Settings.Tab.Items}">
                <ScrollViewer>
                    <settings:ItemsSettingsPanel DataContext="{Binding Items}" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Settings.Tab.Style}">
                <ScrollViewer>
                    <settings:StylePanel DataContext="{Binding Style}" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Settings.Tab.Weather}">
                <ScrollViewer>
                    <StackPanel>
                        <settings:WeatherSettingsPanel DataContext="{Binding Weather}" />
                        <TextBlock Text="{DynamicResource Style.Section.Weather}" Style="{StaticResource Heading}" />
                        <settings:WeatherStylePanel DataContext="{Binding Style}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Settings.Tab.Alerts}">
                <ScrollViewer>
                    <settings:AlertsPanel DataContext="{Binding Alerts}" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Settings.Tab.General}">
                <ScrollViewer>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.Network}" Style="{StaticResource Heading}" Margin="0,2,0,6" />
                        <TextBlock Text="{DynamicResource Settings.Adapter}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="Display" />
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Settings.OpenHistory}" Command="{Binding OpenHistoryCommand}" Padding="10,2" />
                            <TextBlock Text="{DynamicResource Settings.Today}" Margin="0,0,8,0" Foreground="#555" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TodayText}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="{DynamicResource Settings.PingHost}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBox Text="{Binding PingHost, UpdateSourceTrigger=LostFocus}" Padding="4,2" />
                        </DockPanel>

                        <TextBlock Text="{DynamicResource Settings.General}" Style="{StaticResource Heading}" />
                        <CheckBox Content="{DynamicResource Settings.Startup}" IsChecked="{Binding StartWithWindows}" />
                        <CheckBox Content="{DynamicResource Settings.HideFullscreen}" IsChecked="{Binding HideInFullscreen}" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right"
                                       Text="{Binding TrayGapPx, StringFormat={}{0} px}" />
                            <TextBlock Text="{DynamicResource Settings.Gap}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <Slider Minimum="0" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding TrayGapPx}" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
