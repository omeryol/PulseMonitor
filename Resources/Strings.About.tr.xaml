<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Hakkında metinleri (Views/AboutPanel.xaml). Diğer metinler: Strings.tr.xaml -->
    <sys:String x:Key="About.Title">PulseMonitor hakkında</sys:String>
    <sys:String x:Key="About.Tagline">Windows 11 görev çubuğu için hafif sistem monitörü</sys:String>
    <sys:String x:Key="About.Project">Proje ve kaynak kod: </sys:String>
    <sys:String x:Key="About.License">Lisans: </sys:String>
    <sys:String x:Key="About.Inspired">Esin kaynağı:</sys:String>
    <sys:String x:Key="About.InspiredRest">(MIT, © zhongyang219) — teşekkürler. PulseMonitor kendi kodundan oluşur; ondan kod alınmamıştır.</sys:String>

    <sys:String x:Key="About.DataHeading">Veri kaynakları</sys:String>
    <sys:String x:Key="About.Data.OpenMeteo"> — hava tahmini ve konum araması. Lisans: </sys:String>
    <sys:String x:Key="About.Data.Osm"> katkıcıları (Nominatim) — mahalle ve köy araması. Lisans: </sys:String>
    <sys:String x:Key="About.Data.GeoNames"> — köy, kasaba ve ilçe adları (Open-Meteo üzerinden). Lisans: </sys:String>
    <sys:String x:Key="About.Data.Ipify"> — dış IP adresi; yalnızca “Dış IP” öğesi açıkken.</sys:String>

    <sys:String x:Key="About.IconsHeading">Simgeler</sys:String>

    <sys:String x:Key="About.PrivacyHeading">Gizlilik</sys:String>
    <sys:String x:Key="About.Privacy">Ayarlar, trafik geçmişi ve önbellek yalnızca bu bilgisayarda tutulur. Program; hava durumu açıkken tahmin için Open-Meteo’ya, konum aradığınızda Open-Meteo ve OpenStreetMap’e, “Dış IP” açıkken ipify’a, “Ping” açıkken seçtiğiniz sunucuya, güncelleme denetimi açıkken günde bir GitHub’a (yalnızca son sürüm numarası okunur) bağlanır. Başka bir yere veri gönderilmez; hesap, reklam ya da kullanım takibi yoktur.</sys:String>

    <sys:String x:Key="About.FullTexts">Lisans metinlerinin tamamı</sys:String>
    <sys:String x:Key="Menu.About">Hakkında…</sys:String>
    <sys:String x:Key="Menu.Update">⬆ Güncelleme var: {0} — indir</sys:String>
    <sys:String x:Key="Settings.CheckUpdates">Güncellemeleri denetle (günde bir, GitHub)</sys:String>
    <sys:String x:Key="Update.CheckNow">Güncellemeleri denetle</sys:String>
    <sys:String x:Key="Update.Download">İndir</sys:String>
    <sys:String x:Key="Update.Checking">Denetleniyor…</sys:String>
    <sys:String x:Key="Update.Available">Yeni sürüm var: {0}</sys:String>
    <sys:String x:Key="Update.UpToDate">Güncel (son denetim {0})</sys:String>
    <sys:String x:Key="Update.Failed">Denetlenemedi; internet bağlantısını kontrol edin.</sys:String>
    <sys:String x:Key="Update.NotChecked">Henüz denetlenmedi.</sys:String>
    <sys:String x:Key="Update.NotifyTitle">PulseMonitor güncellemesi</sys:String>
    <sys:String x:Key="Update.NotifyText">{0} sürümü yayımlandı. İndirmek için tıklayın.</sys:String>
    <sys:String x:Key="Settings.Tab.About">Hakkında</sys:String>

</ResourceDictionary>
