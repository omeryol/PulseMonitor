<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Renkli hava simgeleri, 28×28 tuval. Her simgede saydam bir 28×28 dikdörtgen var: böylece tüm simgeler
         aynı ölçekte çizilir. Anahtarlar Weather/WeatherCodes.cs → IconKey ile eşleşir. -->

    <SolidColorBrush x:Key="Wx.Color.Sun" Color="#FBBF24" />
    <SolidColorBrush x:Key="Wx.Color.Moon" Color="#E2E8F0" />
    <SolidColorBrush x:Key="Wx.Color.Cloud" Color="#CBD5E1" />
    <SolidColorBrush x:Key="Wx.Color.CloudDark" Color="#94A3B8" />
    <SolidColorBrush x:Key="Wx.Color.Rain" Color="#60A5FA" />
    <SolidColorBrush x:Key="Wx.Color.Bolt" Color="#FACC15" />
    <SolidColorBrush x:Key="Wx.Color.Snow" Color="#E0F2FE" />
    <SolidColorBrush x:Key="Wx.Color.Edge" Color="#7C8A9C" />
    <RectangleGeometry x:Key="Wx.Frame" Rect="0,0,28,28" />

    <Pen x:Key="Wx.RayPen" Brush="{StaticResource Wx.Color.Sun}" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" />
    <Pen x:Key="Wx.EdgePen" Brush="{StaticResource Wx.Color.Edge}" Thickness="0.7" />
    <Pen x:Key="Wx.RainPen" Brush="{StaticResource Wx.Color.Rain}" Thickness="2" StartLineCap="Round" EndLineCap="Round" />
    <Pen x:Key="Wx.FogPen" Brush="{StaticResource Wx.Color.Cloud}" Thickness="2" StartLineCap="Round" EndLineCap="Round" />

    <!-- Parçalar (x:Shared="False": her simgeye ayrı kopya girer) -->
    <DrawingGroup x:Key="Wx.Part.Sun" x:Shared="False">
        <GeometryDrawing Brush="{StaticResource Wx.Color.Sun}">
            <GeometryDrawing.Geometry><EllipseGeometry Center="13,10" RadiusX="4.5" RadiusY="4.5" /></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Pen="{StaticResource Wx.RayPen}"
                         Geometry="M13,2.5 V4 M13,16 V17.5 M5.5,10 H7 M19,10 H20.5 M7.7,4.7 L8.7,5.7 M17.3,14.3 L18.3,15.3 M7.7,15.3 L8.7,14.3 M17.3,5.7 L18.3,4.7" />
    </DrawingGroup>
    <GeometryDrawing x:Key="Wx.Part.Moon" x:Shared="False" Brush="{StaticResource Wx.Color.Moon}"
                     Geometry="M15,6 A6,6 0 1 0 21,13 A5,5 0 0 1 15,6 Z" />

    <DrawingImage x:Key="Wx.ClearDay">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource Wx.Frame}" />
                <DrawingGroup Transform="1,0,0,1,1,4"><StaticResource ResourceKey="Wx.Part.Sun" /></DrawingGroup>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Wx.ClearNight">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource Wx.Frame}" />
                <DrawingGroup Transform="1,0,0,1,-3,3"><StaticResource ResourceKey="Wx.Part.Moon" /></DrawingGroup>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Wx.PartlyDay">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource Wx.Frame}" />
                <DrawingGroup Transform="1,0,0,1,-3,-1"><StaticResource ResourceKey="Wx.Part.Sun" /></DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Wx.Color.Cloud}" Pen="{StaticResource Wx.EdgePen}"
                                 Geometry="M8,24 H20 A4.5,4.5 0 0 0 20.6,15 A6,6 0 0 0 9.2,16.6 A3.8,3.8 0 0 0 8,24 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Wx.PartlyNight">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource Wx.Frame}" />
                <DrawingGroup Transform="1,0,0,1,-6,-3"><StaticResource ResourceKey="Wx.Part.Moon" /></DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Wx.Color.Cloud}" Pen="{StaticResource Wx.EdgePen}"
                                 Geometry="M8,24 H20 A4.5,4.5 0 0 0 20.6,15 A6,6 0 0 0 9.2,16.6 A3.8,3.8 0 0 0 8,24 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Wx.Cloudy">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource Wx.Frame}" />
                <GeometryDrawing Brush="{StaticResource Wx.Color.CloudDark}"
                                 Geometry="M10,19 H22 A4.5,4.5 0 0 0 22.6,10 A6,6 0 0 0 11.2,11.6 A3.8,3.8 0 0 0 10,19 Z" />
                <GeometryDrawing Brush="{StaticResource Wx.Color.Cloud}" Pen="{StaticResource Wx.EdgePen}"
                                 Geometry="M5,24 H17 A4.5,4.5 0 0 0 17.6,15 A6,6 0 0 0 6.2,16.6 A3.8,3.8 0 0 0 5,24 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Wx.Fog">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource Wx.Frame}" />
                <GeometryDrawing Pen="{StaticResource Wx.FogPen}" Geometry="M5,9 H23 M3,14 H23 M6,19 H22" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Wx.Rain">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource Wx.Frame}" />
                <GeometryDrawing Brush="{StaticResource Wx.Color.Cloud}" Pen="{StaticResource Wx.EdgePen}"
                                 Geometry="M8,18 H20 A4.5,4.5 0 0 0 20.6,9 A6,6 0 0 0 9.2,10.6 A3.8,3.8 0 0 0 8,18 Z" />
                <GeometryDrawing Pen="{StaticResource Wx.RainPen}" Geometry="M10,21 L9,24 M15,21 L14,24 M20,21 L19,24" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Wx.Thunder">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource Wx.Frame}" />
                <GeometryDrawing Brush="{StaticResource Wx.Color.CloudDark}"
                                 Geometry="M8,18 H20 A4.5,4.5 0 0 0 20.6,9 A6,6 0 0 0 9.2,10.6 A3.8,3.8 0 0 0 8,18 Z" />
                <GeometryDrawing Brush="{StaticResource Wx.Color.Bolt}" Geometry="M15,16 L11.5,21.5 H14.5 L12.5,26 L18.5,19.5 H15.5 L17.5,16 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Wx.Snow">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource Wx.Frame}" />
                <GeometryDrawing Brush="{StaticResource Wx.Color.Cloud}" Pen="{StaticResource Wx.EdgePen}"
                                 Geometry="M8,18 H20 A4.5,4.5 0 0 0 20.6,9 A6,6 0 0 0 9.2,10.6 A3.8,3.8 0 0 0 8,18 Z" />
                <GeometryDrawing Brush="{StaticResource Wx.Color.Snow}" Pen="{StaticResource Wx.EdgePen}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="10,22.5" RadiusX="1.5" RadiusY="1.5" />
                            <EllipseGeometry Center="15,24.5" RadiusX="1.5" RadiusY="1.5" />
                            <EllipseGeometry Center="20,22.5" RadiusX="1.5" RadiusY="1.5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
