<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Öğe renk paletleri (tasarım tezgâhıyla aynı). Anahtar: Palette.<palet>.<öğe>.OnDark / .OnLight
         Core/ThemeBrushes.cs seçili palete göre "Brush.Item.<öğe>" fırçalarını üretir. -->

    <!-- Canlı -->
    <Color x:Key="Palette.Vivid.Upload.OnDark">#FBBF24</Color>    <Color x:Key="Palette.Vivid.Upload.OnLight">#B45309</Color>
    <Color x:Key="Palette.Vivid.Download.OnDark">#34D399</Color>  <Color x:Key="Palette.Vivid.Download.OnLight">#047857</Color>
    <Color x:Key="Palette.Vivid.Cpu.OnDark">#38BDF8</Color>       <Color x:Key="Palette.Vivid.Cpu.OnLight">#0369A1</Color>
    <Color x:Key="Palette.Vivid.Ram.OnDark">#A78BFA</Color>       <Color x:Key="Palette.Vivid.Ram.OnLight">#6D28D9</Color>
    <Color x:Key="Palette.Vivid.Gpu.OnDark">#2DD4BF</Color>       <Color x:Key="Palette.Vivid.Gpu.OnLight">#0F766E</Color>
    <Color x:Key="Palette.Vivid.Disk.OnDark">#F472B6</Color>      <Color x:Key="Palette.Vivid.Disk.OnLight">#BE185D</Color>
    <Color x:Key="Palette.Vivid.Keyboard.OnDark">#FBBF24</Color>  <Color x:Key="Palette.Vivid.Keyboard.OnLight">#B45309</Color>
    <Color x:Key="Palette.Vivid.Ip.OnDark">#93C5FD</Color>        <Color x:Key="Palette.Vivid.Ip.OnLight">#1D4ED8</Color>
    <Color x:Key="Palette.Vivid.Ping.OnDark">#A3E635</Color>      <Color x:Key="Palette.Vivid.Ping.OnLight">#4D7C0F</Color>

    <!-- Yumuşak -->
    <Color x:Key="Palette.Soft.Upload.OnDark">#F6D79B</Color>     <Color x:Key="Palette.Soft.Upload.OnLight">#92611C</Color>
    <Color x:Key="Palette.Soft.Download.OnDark">#A7E3C4</Color>   <Color x:Key="Palette.Soft.Download.OnLight">#2F7A57</Color>
    <Color x:Key="Palette.Soft.Cpu.OnDark">#A9D8F2</Color>        <Color x:Key="Palette.Soft.Cpu.OnLight">#2F6E93</Color>
    <Color x:Key="Palette.Soft.Ram.OnDark">#CFC3F5</Color>        <Color x:Key="Palette.Soft.Ram.OnLight">#5E4C99</Color>
    <Color x:Key="Palette.Soft.Gpu.OnDark">#A6E6DC</Color>        <Color x:Key="Palette.Soft.Gpu.OnLight">#2B7A70</Color>
    <Color x:Key="Palette.Soft.Disk.OnDark">#F3B8D2</Color>       <Color x:Key="Palette.Soft.Disk.OnLight">#9B4670</Color>
    <Color x:Key="Palette.Soft.Keyboard.OnDark">#F6D79B</Color>   <Color x:Key="Palette.Soft.Keyboard.OnLight">#92611C</Color>
    <Color x:Key="Palette.Soft.Ip.OnDark">#BFD3F2</Color>         <Color x:Key="Palette.Soft.Ip.OnLight">#3E5E99</Color>
    <Color x:Key="Palette.Soft.Ping.OnDark">#D9F0A8</Color>       <Color x:Key="Palette.Soft.Ping.OnLight">#55732A</Color>

    <!-- Tek vurgu: her şey yazı renginde, yalnızca indirme ve klavye vurgulu -->
    <Color x:Key="Palette.Mono.Upload.OnDark">#FFFFFF</Color>     <Color x:Key="Palette.Mono.Upload.OnLight">#111111</Color>
    <Color x:Key="Palette.Mono.Download.OnDark">#5EEAD4</Color>   <Color x:Key="Palette.Mono.Download.OnLight">#0F766E</Color>
    <Color x:Key="Palette.Mono.Cpu.OnDark">#FFFFFF</Color>        <Color x:Key="Palette.Mono.Cpu.OnLight">#111111</Color>
    <Color x:Key="Palette.Mono.Ram.OnDark">#FFFFFF</Color>        <Color x:Key="Palette.Mono.Ram.OnLight">#111111</Color>
    <Color x:Key="Palette.Mono.Gpu.OnDark">#FFFFFF</Color>        <Color x:Key="Palette.Mono.Gpu.OnLight">#111111</Color>
    <Color x:Key="Palette.Mono.Disk.OnDark">#FFFFFF</Color>       <Color x:Key="Palette.Mono.Disk.OnLight">#111111</Color>
    <Color x:Key="Palette.Mono.Keyboard.OnDark">#5EEAD4</Color>   <Color x:Key="Palette.Mono.Keyboard.OnLight">#0F766E</Color>
    <Color x:Key="Palette.Mono.Ip.OnDark">#FFFFFF</Color>         <Color x:Key="Palette.Mono.Ip.OnLight">#111111</Color>
    <Color x:Key="Palette.Mono.Ping.OnDark">#FFFFFF</Color>       <Color x:Key="Palette.Mono.Ping.OnLight">#111111</Color>

</ResourceDictionary>
