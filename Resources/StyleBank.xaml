<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Stil bankası: yeni ekranlar yalnızca bu anlamsal anahtarları kullanır.
      Renkler burada sabitlenmez; Resources/Theme.xaml'deki Ui.* belirteçlerinden gelir.
      Böylece koyu/açık tema ve gelecekteki marka paletleri bileşenleri tek tek yeniden çizmeden değişir.
    -->

    <!-- Metin hiyerarşisi -->
    <Style x:Key="Ui.WindowTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" />
    </Style>
    <Style x:Key="Ui.SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource Ui.Heading}" />
    <Style x:Key="Ui.Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Ui.Caption" TargetType="TextBlock" BasedOn="{StaticResource Ui.Body}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}" />
    </Style>
    <Style x:Key="Ui.FormLabel" TargetType="TextBlock" BasedOn="{StaticResource Ui.Body}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Yüzeyler -->
    <!-- Ui.Card renk kaynağıyla çakışmaması için yüzey stili ayrı ad taşır. -->
    <Style x:Key="Ui.SurfaceCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ui.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ui.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14" />
    </Style>
    <Style x:Key="Ui.InsetCard" TargetType="Border" BasedOn="{StaticResource Ui.SurfaceCard}">
        <Setter Property="Background" Value="{DynamicResource Ui.Hover}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
    </Style>
    <Style x:Key="Ui.DocumentCard" TargetType="Border" BasedOn="{StaticResource Ui.SurfaceCard}">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="Ui.Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Ui.Border}" />
        <Setter Property="Margin" Value="0,12" />
    </Style>

    <!-- Eylemler -->
    <Style x:Key="Ui.PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Tag" Value="Primary" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,6" />
    </Style>
    <Style x:Key="Ui.QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style x:Key="Ui.IconButton" TargetType="Button" BasedOn="{StaticResource Ui.QuietButton}">
        <Setter Property="FontFamily" Value="{StaticResource Ui.Icons}" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <!-- Form denetimleri -->
    <Style x:Key="Ui.TextField" TargetType="TextBox">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" />
        <Setter Property="Background" Value="{DynamicResource Ui.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ui.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="Ui.Select" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="6,3" />
    </Style>
    <Style x:Key="Ui.Toggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" />
        <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style x:Key="Ui.ValueSlider" TargetType="Slider">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="6,0" />
    </Style>
    <Style x:Key="Ui.DateField" TargetType="DatePicker">
        <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style x:Key="Ui.Choice" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" />
    </Style>

    <!-- Koleksiyonlar, varsayılan ListBox stilinden önce tanımlanır; XAML StaticResource ileri başvuru yapmaz. -->
    <Style x:Key="Ui.List" TargetType="ListBox">
        <Setter Property="BorderBrush" Value="{DynamicResource Ui.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Ui.Card}" />
        <Setter Property="Padding" Value="6" />
    </Style>

    <!-- Varsayılan form denetimleri de bankadan gelir; özel durumlarda yukarıdaki anahtarlar açıkça kullanılabilir. -->
    <Style TargetType="TextBox" BasedOn="{StaticResource Ui.TextField}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource Ui.Select}" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource Ui.Toggle}" />
    <Style TargetType="Slider" BasedOn="{StaticResource Ui.ValueSlider}" />
    <Style TargetType="ListBox" BasedOn="{StaticResource Ui.List}" />
    <Style TargetType="DatePicker" BasedOn="{StaticResource Ui.DateField}" />
    <Style TargetType="RadioButton" BasedOn="{StaticResource Ui.Choice}" />

    <!-- Durumlar ve boş alanlar -->
    <Style x:Key="Ui.StatusPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ui.AccentSoft}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Ui.AccentOnSoft}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Ui.EmptyState" TargetType="TextBlock" BasedOn="{StaticResource Ui.Caption}">
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="20" />
    </Style>

    <!-- Geçmiş görünümü: kendi nötr yüzey ve veri vurgularını koruyan kart ailesi. -->
    <Style x:Key="Ui.HistoryCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.History.Card}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style x:Key="Ui.HistoryCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.History.Muted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="Ui.HistoryFigure" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
</ResourceDictionary>
