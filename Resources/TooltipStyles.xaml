<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="clr-namespace:PulseMonitor.Core">

    <!-- Görev çubuğu ayrıntı kartlarının (ve hava ipucunun) görünümü: görev çubuğu temasına uyan yuvarlak kart.
         Açma/kapama: Ayarlar → Görünüm → "Fare üzerine gelince ayrıntı kartı göster" (DetailCards.Enabled). -->
    <Style x:Key="Ui.TooltipCard" TargetType="ToolTip">
        <Setter Property="Placement" Value="Top" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="core:PopupPlacementFix.Enabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Brush.Tooltip.Bg}" BorderBrush="{DynamicResource Brush.Tooltip.Border}"
                            BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="4">
                        <ContentPresenter TextElement.Foreground="{DynamicResource Brush.Text}"
                                          TextElement.FontFamily="{DynamicResource Font.Ui}" TextElement.FontSize="12" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bir sütunun kartları (üst ve alt öğe) alt alta -->
    <DataTemplate x:Key="Ui.DetailCardsTemplate">
        <ItemsControl ItemsSource="{Binding}" MinWidth="200" Typography.NumeralAlignment="Tabular">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Foreground="{Binding Accent}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Rows}" Tag="{Binding Accent}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <DockPanel x:Name="Row" Margin="0,1">
                                                <TextBlock x:Name="Value" DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" Margin="16,0,0,0" />
                                                <TextBlock x:Name="Label" Text="{Binding Label}" Foreground="{DynamicResource Brush.Muted}" />
                                            </DockPanel>
                                            <!-- Doluluk çubuğu (sürücüler): dolu kısım kartın vurgu renginde -->
                                            <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="{Binding BarValue, Mode=OneWay}" Height="4"
                                                         Margin="0,1,0,5" Visibility="Collapsed"
                                                         Foreground="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <ProgressBar.Template>
                                                    <ControlTemplate TargetType="ProgressBar">
                                                        <Grid>
                                                            <Border Background="{DynamicResource Brush.Muted}" Opacity="0.25" CornerRadius="2" />
                                                            <Border x:Name="PART_Track" />
                                                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" />
                                                        </Grid>
                                                    </ControlTemplate>
                                                </ProgressBar.Template>
                                            </ProgressBar>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasBar}" Value="True">
                                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsProcess}" Value="True">
                                                <Setter TargetName="Label" Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                <Setter TargetName="Value" Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                <Setter TargetName="Row" Property="MinHeight" Value="17" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock x:Name="Loading" Text="⌛" Foreground="{Binding Accent}" FontSize="15" HorizontalAlignment="Right"
                                   VerticalAlignment="Top" Visibility="Collapsed" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter TargetName="Loading" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

</ResourceDictionary>
