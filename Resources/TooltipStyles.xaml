<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Görev çubuğu ayrıntı kartlarının (ve hava ipucunun) görünümü: görev çubuğu temasına uyan yuvarlak kart.
         Açma/kapama: Ayarlar → Görünüm → "Fare üzerine gelince ayrıntı kartı göster" (DetailCards.Enabled). -->
    <Style x:Key="Ui.TooltipCard" TargetType="ToolTip">
        <Setter Property="Placement" Value="Top" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Brush.Tooltip.Bg}" BorderBrush="{DynamicResource Brush.Tooltip.Border}"
                            BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="4">
                        <ContentPresenter TextElement.Foreground="{DynamicResource Brush.Text}"
                                          TextElement.FontFamily="{DynamicResource Font.Ui}" TextElement.FontSize="12" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bir sütunun kartları (üst ve alt öğe) alt alta -->
    <DataTemplate x:Key="Ui.DetailCardsTemplate">
        <ItemsControl ItemsSource="{Binding}" MinWidth="200" Typography.NumeralAlignment="Tabular">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding Title}" Foreground="{Binding Accent}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,1">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" Margin="16,0,0,0" />
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Brush.Muted}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

</ResourceDictionary>
