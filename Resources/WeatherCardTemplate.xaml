<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Hava ayrıntı kartının içeriği (WeatherTooltipModel); kartı Views/Cards/DetailCardPopup.cs açar.
         Renkler görev çubuğu temasından gelir (Brush.Tooltip.*). -->
    <BooleanToVisibilityConverter x:Key="CardBoolToVisibility" />

        <DataTemplate x:Key="Ui.WeatherCardTemplate">
            <StackPanel TextElement.Foreground="{DynamicResource Brush.Text}" TextElement.FontFamily="{DynamicResource Font.Ui}"
                        TextElement.FontSize="12" MinWidth="220" Typography.NumeralAlignment="Tabular">
                <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Ui.CardGear}" Tag="Weather" VerticalAlignment="Top" />
                <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                    <Run Text="{Binding Place, Mode=OneWay}" />
                    <Run Text="{Binding Context, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource Brush.Muted}" />
                </TextBlock>
                </DockPanel>

                <DockPanel Margin="0,8,0,0">
                    <Image Source="{Binding Icon}" Width="40" Height="40" Margin="0,0,10,0" DockPanel.Dock="Left" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock>
                            <Run Text="{Binding Temperature, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="{Binding TemperatureBrush}" />
                            <Run Text="{Binding Description, Mode=OneWay}" FontSize="13" />
                        </TextBlock>
                        <TextBlock Text="{Binding Details}" Foreground="{DynamicResource Brush.Muted}" FontSize="11" />
                    </StackPanel>
                </DockPanel>

                <!-- En önemli hava uyarısı (varsa): ⚠ ile uyarı renginde ya da soluk not. Tahmin bilgisidir, resmî uyarı değildir. -->
                <DockPanel Margin="0,6,0,0" MaxWidth="280" Visibility="{Binding HasWarning, Converter={StaticResource CardBoolToVisibility}}">
                    <Image Source="{Binding WarningIcon}" Width="24" Height="24" Margin="0,0,8,0" DockPanel.Dock="Left" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Warning}" Foreground="{Binding WarningBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <!-- Resmî uyarı değildir notu: uyarıdan bir satır boşlukla ayrı, sağa yaslı, italik. -->
                <TextBlock Text="{DynamicResource Weather.Warn.Disclaimer}" Foreground="{DynamicResource Brush.Muted}" FontSize="10" FontStyle="Italic"
                           TextAlignment="Right" TextWrapping="Wrap" Margin="0,12,0,0"
                           Visibility="{Binding HasWarning, Converter={StaticResource CardBoolToVisibility}}" />

                <Rectangle Height="1" Fill="{DynamicResource Brush.Tooltip.Border}" Margin="0,10,0,8" />
                <!-- Saatlik tahmin yatay şerit: her saat bir sütun, sütunlar kart genişliğini eşit paylaşır. -->
                <ItemsControl ItemsSource="{Binding Hours}" Visibility="{Binding HasHours, Converter={StaticResource CardBoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,0" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Brush.Muted}" FontSize="11" HorizontalAlignment="Center" />
                                <Image Source="{Binding Icon}" Width="26" Height="26" Margin="0,3" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Temperature}" FontWeight="SemiBold" Foreground="{Binding TemperatureBrush}" HorizontalAlignment="Center" />
                                <!-- Yağış yoksa yer korunur (Hidden): satırlar hizalı kalsın. -->
                                <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Tooltip.Rain}" HorizontalAlignment="Center" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRain}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="☂ " /><Run Text="{Binding Rain, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Günlük tahmin: gün adı, simge, en yüksek / en düşük, yağış. Saatlik ile birlikteyse arada çizgi. -->
                <Rectangle Height="1" Fill="{DynamicResource Brush.Tooltip.Border}" Margin="0,8,0,8"
                           Visibility="{Binding HasBoth, Converter={StaticResource CardBoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Days}" Visibility="{Binding HasDays, Converter={StaticResource CardBoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,0" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Day}" Foreground="{DynamicResource Brush.Muted}" FontSize="11" HorizontalAlignment="Center" />
                                <Image Source="{Binding Icon}" Width="26" Height="26" Margin="0,3" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding High}" FontWeight="SemiBold" Foreground="{Binding HighBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Low}" FontSize="11" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Center" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Tooltip.Rain}" HorizontalAlignment="Center" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRain}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="☂ " /><Run Text="{Binding Rain, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Diğer takip edilen konumlar: ad solda, simge + sıcaklık sağda. -->
                <StackPanel Visibility="{Binding HasOthers, Converter={StaticResource CardBoolToVisibility}}">
                    <Rectangle Height="1" Fill="{DynamicResource Brush.Tooltip.Border}" Margin="0,8,0,6" />
                    <ItemsControl ItemsSource="{Binding Others}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Temperature}" FontWeight="SemiBold" MinWidth="34"
                                               TextAlignment="Right" Foreground="{Binding TemperatureBrush}" VerticalAlignment="Center" />
                                    <Image DockPanel.Dock="Right" Source="{Binding Icon}" Width="20" Height="20" Margin="8,0,4,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{DynamicResource Weather.ClickToSwitch}" FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0" />
                </StackPanel>

                <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource Brush.Muted}">
                    <Run Text="{Binding Updated, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{DynamicResource Weather.Stale}" FontSize="11" Foreground="{DynamicResource Brush.Load.Warn}" TextWrapping="Wrap"
                           Visibility="{Binding IsStale, Converter={StaticResource CardBoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

</ResourceDictionary>
