<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PulseMonitor.ico</ApplicationIcon>
    <Version>0.14.0</Version>
    <Product>PulseMonitor</Product>
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\PulseMonitor.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Dil dosyaları: yeni dil = lang klasörüne yeni .json. Türkçe ayrıca gömülür (klasör silinse de çalışsın). -->
    <Content Include="lang\*.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="lang\tr.json" LogicalName="PulseMonitor.lang.tr.json" />
    <!-- Fluent Emoji 3D (MIT), tools/fetch_icons.ps1 ile 64 px'e küçültüldü -->
    <Resource Include="Assets\Weather\*.png" />
    <!-- Meteocons ve Makin-Things (MIT), tools/render_icons.ps1 ile film şeridine çevrildi -->
    <Resource Include="Assets\WeatherAnim\**\*.png" />
    <!-- Hakkında penceresinde gösterilen lisans metinleri ve simge -->
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="LICENSE" />
    <Resource Include="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

</Project>
