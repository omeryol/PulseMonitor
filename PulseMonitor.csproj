<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PulseMonitor.ico</ApplicationIcon>
    <Version>0.17.2</Version>
    <!-- Sürüm adı Hakkında'da gösterilir; release-notes/v<sürüm>.md başındaki ad satırıyla aynı olmalı (test denetler) -->
    <ReleaseName>Alize</ReleaseName>
    <Product>PulseMonitor</Product>
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>PulseMonitor.WindowsTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ReleaseName</_Parameter1>
      <_Parameter2>$(ReleaseName)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- tests/ ayrı bir proje; uygulamanın derlemesine girmesin -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\PulseMonitor.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Dil dosyaları: yeni dil = lang klasörüne yeni .json. Türkçe ayrıca gömülür (klasör silinse de çalışsın). -->
    <Content Include="lang\*.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="lang\tr.json" LogicalName="PulseMonitor.lang.tr.json" />
    <!-- Fluent Emoji 3D (MIT), tools/fetch_icons.ps1 ile 64 px'e küçültüldü -->
    <Resource Include="Assets\Weather\*.png" />
    <Resource Include="Assets\Weather\Cinematic3D\*.png" />
    <!-- Meteocons ve Makin-Things (MIT), tools/render_icons.ps1 ile film şeridine çevrildi -->
    <Resource Include="Assets\WeatherAnim\**\*.png" />
    <!-- Hakkında penceresinde gösterilen lisans metinleri ve simge -->
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="LICENSE" />
    <Resource Include="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

</Project>
